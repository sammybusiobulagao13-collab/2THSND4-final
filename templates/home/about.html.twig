{% extends 'base.html.twig' %}

{% block title %}2THSND4 - About & Customer Service{% endblock %}

{% block stylesheets %}
<style>
    .about-page {
        min-height: 100vh;
        padding: 200px 0 100px;
        background-color: #06060c;
        background-image: 
            radial-gradient(circle at 10% 25%, rgba(255, 255, 255, 0.03) 0%, transparent 45%),
            radial-gradient(circle at 90% 70%, rgba(255, 255, 255, 0.015) 0%, transparent 45%),
            url('{{ asset('images/texture.jpg') }}');
        background-size: cover;
        background-attachment: fixed;
        background-position: center;
        position: relative;
    }
    .about-page::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0; bottom: 0;
        background: rgba(6, 6, 12, 0.88);
        pointer-events: none;
        z-index: 0;
    }
    .about-page .container {
        position: relative;
        z-index: 1;
        max-width: 1200px;
    }

    /* ── Hero / About Us Box ── */
    .about-hero {
        background: linear-gradient(135deg, rgba(255, 255, 255, 0.06) 0%, rgba(255, 255, 255, 0.02) 100%);
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 20px;
        padding: 55px 60px;
        backdrop-filter: blur(16px);
        margin-bottom: 45px;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
        text-align: center;
        position: relative;
        overflow: hidden;
    }
    .about-hero::before {
        content: '';
        position: absolute;
        top: 0; left: 15%; right: 15%; height: 1px;
        background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.25), transparent);
    }
    .about-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 6px 18px;
        border-radius: 50px;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.12);
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 2px;
        color: #ddd;
        text-transform: uppercase;
        margin-bottom: 18px;
    }
    .about-hero-text h1 {
        font-family: var(--font-primary);
        font-size: 46px;
        color: #fff;
        letter-spacing: 3px;
        margin-bottom: 24px;
        text-shadow: 0 4px 20px rgba(0,0,0,0.8);
    }
    .about-description {
        max-width: 920px;
        margin: 0 auto;
    }
    .about-description p {
        font-family: Arial, sans-serif;
        font-size: 15.5px;
        color: #bbb;
        line-height: 1.8;
        margin-bottom: 16px;
    }
    .about-description p:last-child {
        margin-bottom: 0;
    }

    /* ── Features ── */
    .about-features-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 18px;
        margin-bottom: 60px;
    }
    .about-feature-card {
        background: linear-gradient(135deg, rgba(255, 255, 255, 0.06) 0%, rgba(255, 255, 255, 0.02) 100%);
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 16px;
        padding: 24px 20px;
        backdrop-filter: blur(14px);
        transition: all 0.3s ease;
        display: flex;
        flex-direction: column;
    }
    .about-feature-card:hover {
        transform: translateY(-4px);
        border-color: rgba(255, 255, 255, 0.2);
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.4);
    }
    .af-icon-box {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        margin-bottom: 16px;
        border: 1px solid;
    }
    .about-feature-card h3 {
        font-family: var(--font-primary);
        font-size: 16px;
        letter-spacing: 1px;
        color: #fff;
        margin-bottom: 8px;
    }
    .about-feature-card p {
        font-family: Arial, sans-serif;
        font-size: 13px;
        color: #888;
        line-height: 1.5;
        margin: 0;
    }

    /* ── Customer Service Section ── */
    .about-cs-wrapper {
        border-top: 1px solid rgba(255, 255, 255, 0.08);
        padding-top: 55px;
    }
    .about-cs-header {
        text-align: center;
        margin-bottom: 45px;
    }
    .about-cs-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 6px 18px;
        border-radius: 50px;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.12);
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 2px;
        color: #ddd;
        text-transform: uppercase;
        margin-bottom: 14px;
    }
    .cs-dot-green {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #ffffff;
        box-shadow: 0 0 10px rgba(255, 255, 255, 0.7);
    }
    .about-cs-header h2 {
        font-family: var(--font-primary);
        font-size: 42px;
        color: #fff;
        letter-spacing: 3px;
        margin-bottom: 12px;
        text-shadow: 0 4px 20px rgba(0,0,0,0.8);
    }
    .about-cs-header p {
        font-family: Arial, sans-serif;
        font-size: 14.5px;
        color: #888;
        max-width: 600px;
        margin: 0 auto;
        line-height: 1.6;
    }

    /* ── Customer Service Grid ── */
    .cs-modern-grid {
        display: grid;
        grid-template-columns: 1.25fr 1fr;
        gap: 30px;
        align-items: start;
        margin-bottom: 40px;
    }

    /* Left: FAQs Box */
    .cs-panel-card {
        background: linear-gradient(135deg, rgba(255, 255, 255, 0.06) 0%, rgba(255, 255, 255, 0.02) 100%);
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 18px;
        padding: 30px;
        backdrop-filter: blur(16px);
    }
    .cs-panel-title {
        display: flex;
        align-items: center;
        gap: 12px;
        font-family: var(--font-primary);
        font-size: 18px;
        letter-spacing: 1.5px;
        color: #fff;
        margin-bottom: 22px;
        padding-bottom: 14px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    }
    .cs-panel-title i {
        font-size: 18px;
    }

    /* FAQ Accordion List */
    .cs-faq-stack {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }
    .cs-faq-block {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.06);
        border-radius: 12px;
        padding: 16px 18px;
        cursor: pointer;
        transition: all 0.25s ease;
    }
    .cs-faq-block:hover {
        background: rgba(255, 255, 255, 0.05);
        border-color: rgba(255, 255, 255, 0.15);
    }
    .cs-faq-block.open {
        border-color: rgba(255, 255, 255, 0.35);
        background: rgba(255, 255, 255, 0.04);
    }
    .cs-faq-question {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 14px;
        font-weight: 700;
        color: #fff;
    }
    .cs-faq-question i {
        font-size: 12px;
        color: #888;
        transition: transform 0.25s ease;
    }
    .cs-faq-block.open .cs-faq-question i {
        transform: rotate(180deg);
        color: #ffffff;
    }
    .cs-faq-answer {
        display: none;
        margin-top: 12px;
        padding-top: 12px;
        border-top: 1px dashed rgba(255, 255, 255, 0.08);
        font-size: 13px;
        color: #aaa;
        line-height: 1.6;
        font-family: Arial, sans-serif;
    }
    .cs-faq-block.open .cs-faq-answer {
        display: block;
    }

    /* Right Column: Policies Stack */
    .cs-policies-stack {
        display: flex;
        flex-direction: column;
        gap: 24px;
    }
    .cs-policy-card {
        background: linear-gradient(135deg, rgba(255, 255, 255, 0.06) 0%, rgba(255, 255, 255, 0.02) 100%);
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 18px;
        padding: 26px;
        backdrop-filter: blur(16px);
    }
    .cs-policy-items {
        display: flex;
        flex-direction: column;
        gap: 14px;
    }
    .cs-policy-row {
        display: flex;
        align-items: flex-start;
        gap: 14px;
    }
    .cs-policy-dot {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.08);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 13px;
        flex-shrink: 0;
        margin-top: 2px;
    }
    .cs-policy-text strong {
        display: block;
        color: #fff;
        font-size: 13.5px;
        margin-bottom: 3px;
    }
    .cs-policy-text p {
        font-family: Arial, sans-serif;
        font-size: 12.5px;
        color: #888;
        line-height: 1.5;
        margin: 0;
    }

    /* ── Bottom CTA Banner ── */
    .about-cs-cta {
        background: linear-gradient(135deg, rgba(255, 255, 255, 0.06) 0%, rgba(255, 255, 255, 0.02) 100%);
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 18px;
        padding: 28px 35px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 20px;
        backdrop-filter: blur(14px);
    }
    .about-cs-cta-info h3 {
        font-family: var(--font-primary);
        font-size: 20px;
        letter-spacing: 1.5px;
        color: #fff;
        margin-bottom: 5px;
    }
    .about-cs-cta-info p {
        font-family: Arial, sans-serif;
        font-size: 13.5px;
        color: #aaa;
        margin: 0;
    }
    .about-cs-cta-btns {
        display: flex;
        gap: 12px;
        align-items: center;
        flex-wrap: wrap;
    }

    /* Responsive */
    @media (max-width: 992px) {
        .about-hero {
            padding: 40px 25px;
        }
        .about-hero-text h1 {
            font-size: 36px;
        }
        .about-features-grid {
            grid-template-columns: repeat(2, 1fr);
        }
        .cs-modern-grid {
            grid-template-columns: 1fr;
        }
    }
    @media (max-width: 600px) {
        .about-features-grid {
            grid-template-columns: 1fr;
        }
        .about-page {
            padding: 170px 15px 70px;
        }
        .about-cs-header h2 {
            font-size: 30px;
        }
        .about-cs-cta {
            flex-direction: column;
            text-align: center;
        }
        .about-cs-cta-btns {
            justify-content: center;
            width: 100%;
        }
    }
</style>
{% endblock %}

{% block body %}
<section class="about-page">
    <div class="container">
        <div class="about-page-content">

            <!-- ── HERO / ABOUT US BOX ── -->
            <div class="about-hero">
                <div class="about-hero-text">
                    <div class="about-badge">
                        <span class="cs-dot-green"></span>
                        <span>2THSND4 Origins &bull; Streetwear Culture</span>
                    </div>
                    <h1>ABOUT US</h1>
                    <div class="about-description">
                        <p>To elevate the <strong>2THSND4</strong> brand into a globally recognized streetwear staple, while continuously refining our design skills and pushing creative boundaries. We are committed to sharing our art with the world, delivering maximum comfort to everyday wearers, and empowering individuals to express their confidence and unique identity through bold apparel.</p>
                        <p>2THSND4 was born from the idea that everyone deserves to feel confident in what they wear. We combine premium quality fabrics with modern designs to create outfits that make you stand out.</p>
                        <p>Rooted in contemporary underground culture and dedicated local craftsmanship, every drop, cut, and silhouette represents our relentless pursuit of authenticity and individuality.</p>
                    </div>
                </div>
            </div>

            <!-- ── 4 KEY BRAND PILLARS ── -->
            <div class="about-features-grid">
                <!-- Feature 1 -->
                <div class="about-feature-card">
                    <div class="af-icon-box" style="background: rgba(255, 255, 255, 0.06); color: #ffffff; border-color: rgba(255, 255, 255, 0.16);">
                        <i class="fas fa-gem"></i>
                    </div>
                    <h3>Premium Materials</h3>
                    <p>Heavyweight combed cotton and custom weaves engineered for luxury comfort and durability.</p>
                </div>

                <!-- Feature 2 -->
                <div class="about-feature-card">
                    <div class="af-icon-box" style="background: rgba(255, 255, 255, 0.06); color: #ffffff; border-color: rgba(255, 255, 255, 0.16);">
                        <i class="fas fa-leaf"></i>
                    </div>
                    <h3>Sustainable Craft</h3>
                    <p>Mindfully produced in limited quantity drops to prevent overproduction and textile waste.</p>
                </div>

                <!-- Feature 3 -->
                <div class="about-feature-card">
                    <div class="af-icon-box" style="background: rgba(255, 255, 255, 0.06); color: #ffffff; border-color: rgba(255, 255, 255, 0.16);">
                        <i class="fas fa-truck-fast"></i>
                    </div>
                    <h3>Free Shipping &#8369;2,000+</h3>
                    <p>Unlock zero delivery charges across the Philippines whenever your cart hits &#8369;2,000.</p>
                </div>

                <!-- Feature 4 -->
                <div class="about-feature-card">
                    <div class="af-icon-box" style="background: rgba(255, 255, 255, 0.06); color: #ffffff; border-color: rgba(255, 255, 255, 0.16);">
                        <i class="fas fa-shield-alt"></i>
                    </div>
                    <h3>30-Day Guarantee</h3>
                    <p>Not completely satisfied with your sizing? Enjoy hassle-free returns or exchanges.</p>
                </div>
            </div>

            <!-- ── CUSTOMER SERVICE SECTION ── -->
            <div class="about-cs-wrapper">
                <div class="about-cs-header">
                    <div class="about-cs-badge">
                        <span class="cs-dot-green"></span>
                        <span>2THSND4 Client Care &bull; Fulfillment Policies</span>
                    </div>
                    <h2>CUSTOMER SERVICE</h2>
                    <p>Essential guidance on parcel dispatch, accepted payment methods, our 30-day exchange policy, and frequently asked client questions.</p>
                </div>

                <!-- Modern 2-Column Grid -->
                <div class="cs-modern-grid">

                    <!-- Left: FAQs Accordion -->
                    <div class="cs-panel-card" id="faqs">
                        <div class="cs-panel-title">
                            <i class="fas fa-circle-question" style="color: #ffffff;"></i>
                            <span>FREQUENTLY ASKED QUESTIONS</span>
                        </div>

                        <div class="cs-faq-stack">
                            <!-- Q1 -->
                            <div class="cs-faq-block open" onclick="toggleAboutFaq(this)">
                                <div class="cs-faq-question">
                                    <span>What payment methods do you accept?</span>
                                    <i class="fas fa-chevron-down"></i>
                                </div>
                                <div class="cs-faq-answer">
                                    We accept <strong>Cash on Delivery (COD)</strong>, <strong>GCash</strong>, <strong>Maya</strong>, and direct Online Bank Transfers. Cash on Delivery is available nationwide with no additional surcharges.
                                </div>
                            </div>

                            <!-- Q2 -->
                            <div class="cs-faq-block" onclick="toggleAboutFaq(this)">
                                <div class="cs-faq-question">
                                    <span>How long does shipping take? (Domestic &amp; International)</span>
                                    <i class="fas fa-chevron-down"></i>
                                </div>
                                <div class="cs-faq-answer">
                                    <div style="margin-bottom: 8px;">
                                        <strong>&bull; Domestic (Philippines):</strong> Standard delivery takes <strong>2 to 4 business days</strong> within Metro Manila &amp; Central Visayas, and <strong>3 to 7 business days</strong> for provincial regions nationwide via LBC Express &amp; J&amp;T Express.
                                    </div>
                                    <div>
                                        <strong>&bull; International Shipping:</strong> We also ship worldwide! International deliveries typically take <strong>7 to 15 business days</strong> depending on your destination country and customs clearance via DHL Express or FedEx.
                                    </div>
                                </div>
                            </div>

                            <!-- Q3 -->
                            <div class="cs-faq-block" onclick="toggleAboutFaq(this)">
                                <div class="cs-faq-question">
                                    <span>Can I cancel or modify my order after placing it?</span>
                                    <i class="fas fa-chevron-down"></i>
                                </div>
                                <div class="cs-faq-answer">
                                    Yes! Customers can cancel orders while in <em>Processing</em> or <em>Approved</em> status directly through your <a href="{{ path('app_my_orders') }}" style="color: #ffffff; text-decoration: underline;">My Orders</a> page. When cancelled, inventory stock is automatically returned to the store immediately.
                                </div>
                            </div>

                            <!-- Q4 -->
                            <div class="cs-faq-block" onclick="toggleAboutFaq(this)">
                                <div class="cs-faq-question">
                                    <span>How do I determine the right size for me?</span>
                                    <i class="fas fa-chevron-down"></i>
                                </div>
                                <div class="cs-faq-answer">
                                    All 2THSND4 pieces feature our signature modern relaxed streetwear cut. Sizing ranges from S to XL on every product drop. If you prefer a fitted look, consider sizing one step down, or contact our team for advice.
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Right: Shipping & Returns Stack -->
                    <div class="cs-policies-stack">

                        <!-- Shipping Policy -->
                        <div class="cs-policy-card" id="shipping">
                            <div class="cs-panel-title">
                                <i class="fas fa-truck-fast" style="color: #ffffff;"></i>
                                <span>SHIPPING &amp; DISPATCH</span>
                            </div>

                            <div class="cs-policy-items">
                                <div class="cs-policy-row">
                                    <div class="cs-policy-dot" style="color: #ffffff; background: rgba(255, 255, 255, 0.06); border-color: rgba(255, 255, 255, 0.15);">
                                        <i class="fas fa-clock"></i>
                                    </div>
                                    <div class="cs-policy-text">
                                        <strong>Delivery Timeline (Domestic &amp; Worldwide)</strong>
                                        <p><strong>Philippines:</strong> 3&ndash;7 business days via LBC &amp; J&amp;T Express.<br><strong>International:</strong> 7&ndash;15 business days via DHL &amp; FedEx.</p>
                                    </div>
                                </div>

                                <div class="cs-policy-row">
                                    <div class="cs-policy-dot" style="color: #ffffff; background: rgba(255, 255, 255, 0.06); border-color: rgba(255, 255, 255, 0.15);">
                                        <i class="fas fa-tag"></i>
                                    </div>
                                    <div class="cs-policy-text">
                                        <strong>Standard Fee &#8369;120.00</strong>
                                        <p>Fixed rate of &#8369;120.00 on orders under &#8369;2,000. Carts of <strong>&#8369;2,000 and above get 100% FREE SHIPPING</strong>.</p>
                                    </div>
                                </div>

                                <div class="cs-policy-row">
                                    <div class="cs-policy-dot" style="color: #ffffff; background: rgba(255, 255, 255, 0.06); border-color: rgba(255, 255, 255, 0.15);">
                                        <i class="fas fa-box"></i>
                                    </div>
                                    <div class="cs-policy-text">
                                        <strong>Courier Partners</strong>
                                        <p>Domestic: LBC Express, J&amp;T Express, Flash Express.<br>International: DHL Express &amp; FedEx with global tracking.</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Return & Exchange Policy -->
                        <div class="cs-policy-card" id="returns">
                            <div class="cs-panel-title">
                                <i class="fas fa-arrows-rotate" style="color: #ffffff;"></i>
                                <span>RETURN &amp; EXCHANGE</span>
                            </div>

                            <div class="cs-policy-items">
                                <div class="cs-policy-row">
                                    <div class="cs-policy-dot" style="color: #ffffff; background: rgba(255, 255, 255, 0.06); border-color: rgba(255, 255, 255, 0.15);">
                                        <i class="fas fa-calendar-check"></i>
                                    </div>
                                    <div class="cs-policy-text">
                                        <strong>30-Day Client Guarantee</strong>
                                        <p>Return any unworn, unwashed item with original tags attached within 30 days of arrival.</p>
                                    </div>
                                </div>

                                <div class="cs-policy-row">
                                    <div class="cs-policy-dot" style="color: #ffffff; background: rgba(255, 255, 255, 0.06); border-color: rgba(255, 255, 255, 0.15);">
                                        <i class="fas fa-shirt"></i>
                                    </div>
                                    <div class="cs-policy-text">
                                        <strong>Hassle-Free Size Swaps</strong>
                                        <p>Need a different fit? Contact our support staff and we'll swap your size at no extra processing fee.</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>

                </div>

                <!-- Bottom CTA -->
                <div class="about-cs-cta">
                    <div class="about-cs-cta-info">
                        <h3>NEED PERSONALIZED SUPPORT?</h3>
                        <p>Our client care crew is available Monday through Saturday to answer questions or process requests.</p>
                    </div>
                    <div class="about-cs-cta-btns">
                        <a href="{{ path('app_contact') }}" class="btn btn-primary" style="padding: 12px 28px; border-radius: 50px; text-decoration: none; font-size: 13px; font-weight: bold; letter-spacing: 1px;">
                            <i class="fas fa-paper-plane" style="margin-right: 6px;"></i> CONTACT OUR TEAM
                        </a>
                        <a href="{{ path('app_my_orders') }}" class="btn btn-sm" style="display: inline-flex; align-items: center; gap: 6px; padding: 12px 24px; border-radius: 50px; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.2); color: #fff; text-decoration: none; font-size: 13px;">
                            <i class="fas fa-box-open"></i> VIEW MY ORDERS
                        </a>
                    </div>
                </div>

            </div>

        </div>
    </div>
</section>

<script>
    function toggleAboutFaq(element) {
        const isOpen = element.classList.contains('open');
        document.querySelectorAll('.cs-faq-block').forEach(el => el.classList.remove('open'));
        if (!isOpen) {
            element.classList.add('open');
        }
    }
</script>
{% endblock %}
