{% extends 'staff/layout.html.twig' %}

{% block title %}2THSND4 - Staff Dashboard{% endblock %}

{% block page_title %}
    <h1>DASHBOARD</h1>
    <p>Your staff overview for today's operations</p>
{% endblock %}

{% block staff_body %}

<!-- Stats Row -->
<div class="staff-stat-grid">
    <div class="staff-stat" style="border-top: 3px solid #17a2b8;">
        <div class="num" style="color:#17a2b8;">{{ totalProducts }}</div>
        <div class="lbl">Total Products</div>
        <div style="color:#555; font-size:11px; margin-top:5px;">{{ myProducts }} created by you</div>
    </div>
    <div class="staff-stat" style="border-top: 3px solid #ffd659;">
        <div class="num" style="color:#ffd659;">{{ processingOrders }}</div>
        <div class="lbl">Processing</div>
        <div style="color:#555; font-size:11px; margin-top:5px;">Needs attention</div>
    </div>
    <div class="staff-stat" style="border-top: 3px solid #5bc0de;">
        <div class="num" style="color:#5bc0de;">{{ approvedOrders }}</div>
        <div class="lbl">Approved</div>
        <div style="color:#555; font-size:11px; margin-top:5px;">Ready to ship</div>
    </div>
    <div class="staff-stat" style="border-top: 3px solid #66b0ff;">
        <div class="num" style="color:#66b0ff;">{{ shippedOrders }}</div>
        <div class="lbl">Shipped</div>
        <div style="color:#555; font-size:11px; margin-top:5px;">In transit</div>
    </div>
    <div class="staff-stat" style="border-top: 3px solid #5dd879;">
        <div class="num" style="color:#5dd879;">{{ deliveredOrders }}</div>
        <div class="lbl">Delivered</div>
        <div style="color:#555; font-size:11px; margin-top:5px;">Completed</div>
    </div>
    <div class="staff-stat" style="border-top: 3px solid #ff6b7b;">
        <div class="num" style="color:#ff6b7b;">{{ unreadMessages }}</div>
        <div class="lbl">Unread Msgs</div>
        <div style="color:#555; font-size:11px; margin-top:5px;">Customer inquiries</div>
    </div>
</div>

<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 10px;">

    <!-- Recent Orders -->
    <div class="staff-card">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:18px;">
            <h3 style="font-size:14px; text-transform:uppercase; letter-spacing:1px; color:#fff;">
                <i class="fas fa-shipping-fast" style="color:#ffd659; margin-right:8px;"></i>Recent Orders
            </h3>
            <a href="{{ path('app_staff_orders') }}" class="btn-sm-cyan" style="font-size:11px; padding:5px 12px;">
                View All <i class="fas fa-arrow-right"></i>
            </a>
        </div>

        {% if recentOrders|length > 0 %}
            <div style="overflow-x:auto;">
                <table class="staff-table">
                    <thead>
                        <tr>
                            <th>Order #</th>
                            <th>Customer</th>
                            <th>Total</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for order in recentOrders %}
                            <tr>
                                <td>
                                    <strong style="color:#fff; font-size:12px;">#{{ order.orderNumber }}</strong>
                                    <div style="font-size:10px; color:#555;">{{ order.createdAt|date('M d, Y') }}</div>
                                </td>
                                <td style="font-size:12px;">{{ order.user.name }}</td>
                                <td style="color:#5dd879; font-weight:bold; font-size:13px;">{{ order.formattedTotal }}</td>
                                <td>
                                    {% set sc = order.status|lower %}
                                    <span class="sbadge sbadge-{{ sc }}">{{ order.status }}</span>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <div style="text-align:center; padding:30px; color:#555; font-size:13px;">
                <i class="fas fa-box-open" style="font-size:28px; display:block; margin-bottom:10px;"></i>
                No orders yet.
            </div>
        {% endif %}
    </div>

    <!-- Recent Inquiries -->
    <div class="staff-card">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:18px;">
            <h3 style="font-size:14px; text-transform:uppercase; letter-spacing:1px; color:#fff;">
                <i class="fas fa-envelope" style="color:#ff6b7b; margin-right:8px;"></i>Customer Inquiries
                {% if unreadMessages > 0 %}
                    <span style="background:#ff6b7b; color:#fff; font-size:10px; padding:2px 7px; border-radius:20px; margin-left:6px;">{{ unreadMessages }} new</span>
                {% endif %}
            </h3>
            <a href="{{ path('app_staff_inquiries') }}" class="btn-sm-cyan" style="font-size:11px; padding:5px 12px;">
                View All <i class="fas fa-arrow-right"></i>
            </a>
        </div>

        {% if recentMessages|length > 0 %}
            <div style="display: flex; flex-direction: column; gap: 10px;">
                {% for msg in recentMessages|slice(0,5) %}
                    <div style="padding: 12px 14px; border-radius: 10px; background: rgba(255,255,255,0.03); border: 1px solid {{ msg.status == 'unread' ? 'rgba(220,53,69,0.2)' : 'rgba(255,255,255,0.06)' }}; display:flex; justify-content:space-between; align-items:flex-start; gap:12px;">
                        <div style="flex:1;">
                            <div style="display:flex; align-items:center; gap:8px; margin-bottom:4px;">
                                <strong style="color:#fff; font-size:13px;">{{ msg.name }}</strong>
                                <span class="sbadge sbadge-{{ msg.status }}">{{ msg.status }}</span>
                            </div>
                            <div style="font-size:12px; color:#17a2b8; margin-bottom:3px; font-weight:600;">{{ msg.subject }}</div>
                            <div style="font-size:11px; color:#666;">{{ msg.message|slice(0,70) }}{% if msg.message|length > 70 %}...{% endif %}</div>
                        </div>
                        <div style="font-size:10px; color:#555; white-space:nowrap; margin-top:2px;">{{ msg.createdAt|date('M d') }}</div>
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <div style="text-align:center; padding:30px; color:#555; font-size:13px;">
                <i class="fas fa-inbox" style="font-size:28px; display:block; margin-bottom:10px;"></i>
                No messages yet.
            </div>
        {% endif %}
    </div>

</div>

{% endblock %}
