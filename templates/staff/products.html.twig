{% extends 'staff/layout.html.twig' %}

{% block title %}2THSND4 - Staff Product Catalog{% endblock %}

{% block page_title %}
    <h1>STAFF PRODUCT CATALOG</h1>
    <p>Manage streetwear drops, monitor inventory levels, and create piece listings.</p>
{% endblock %}

{% block staff_body %}

<!-- Header & Add Button -->
<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px; flex-wrap: wrap; gap: 15px;">
    <!-- Filter tabs -->
    <div style="display: flex; gap: 10px;">
        <a href="{{ path('app_staff_products') }}" class="staff-tab {{ currentFilter == 'all' ? 'active' : '' }}" style="padding: 8px 18px; border-radius: 50px; background: {{ currentFilter == 'all' ? '#17a2b8' : 'rgba(255,255,255,0.05)' }}; border: 1px solid {{ currentFilter == 'all' ? '#17a2b8' : 'rgba(255,255,255,0.15)' }}; color: {{ currentFilter == 'all' ? '#000' : '#aaa' }}; font-weight: 700; text-decoration: none; font-size: 13px;">
            <i class="fas fa-globe"></i> All Products
        </a>
        <a href="{{ path('app_staff_products', {'filter': 'my'}) }}" class="staff-tab {{ currentFilter == 'my' ? 'active' : '' }}" style="padding: 8px 18px; border-radius: 50px; background: {{ currentFilter == 'my' ? '#17a2b8' : 'rgba(255,255,255,0.05)' }}; border: 1px solid {{ currentFilter == 'my' ? '#17a2b8' : 'rgba(255,255,255,0.15)' }}; color: {{ currentFilter == 'my' ? '#000' : '#aaa' }}; font-weight: 700; text-decoration: none; font-size: 13px;">
            <i class="fas fa-user-check"></i> My Created Records Only
        </a>
    </div>

    <div>
        <a href="{{ path('app_staff_product_new') }}" class="btn-sm-cyan" style="padding: 10px 22px; border-radius: 50px; font-size: 13px;">
            <i class="fas fa-plus-circle"></i> ADD NEW PRODUCT
        </a>
    </div>
</div>

<!-- Search Input -->
<div class="staff-card" style="margin-bottom: 20px; padding: 16px 20px;">
    <form method="GET" action="{{ path('app_staff_products') }}" style="display: flex; gap: 12px; align-items: center;">
        <input type="hidden" name="filter" value="{{ currentFilter }}">
        <div style="flex: 1;">
            <input type="text" name="search" value="{{ search }}" placeholder="Search products by title, category, or sizes..." style="width: 100%; padding: 10px 16px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; color: #fff; font-size: 13.5px; box-sizing: border-box;">
        </div>
        <button type="submit" class="btn-sm-cyan" style="padding: 10px 18px; border-radius: 8px;">
            <i class="fas fa-search"></i> Search
        </button>
        {% if search %}
            <a href="{{ path('app_staff_products', {'filter': currentFilter}) }}" class="btn-sm-red" style="padding: 10px 18px; border-radius: 8px; text-decoration: none;">
                Clear
            </a>
        {% endif %}
    </form>
</div>

<!-- Products Table -->
<div class="staff-card">
    <div style="overflow-x: auto;">
        <table class="staff-table">
            <thead>
                <tr>
                    <th>Item</th>
                    <th>Category</th>
                    <th>Price</th>
                    <th>Stock</th>
                    <th>Ownership</th>
                    <th>Action Rights</th>
                </tr>
            </thead>
            <tbody>
                {% for product in products %}
                    {% set isOwner = product.createdBy == app.user %}
                    <tr>
                        <td style="display: flex; align-items: center; gap: 12px;">
                            <img src="{{ asset('images/' ~ product.image) }}" alt="{{ product.name }}" style="width: 44px; height: 44px; object-fit: contain; border-radius: 8px; background: rgba(255,255,255,0.05);">
                            <div>
                                <strong style="color: #fff;">{{ product.name }}</strong>
                                <div style="font-size: 11px; color: #888;">Sizes: {{ product.sizes }}</div>
                            </div>
                        </td>
                        <td>{{ product.category }}</td>
                        <td style="color: #fff; font-weight: 600;">{{ product.formattedPrice }}</td>
                        <td>
                            {% if product.isOutOfStock %}
                                <span style="color: #ff6b7b; font-weight: bold;">0 (Sold Out)</span>
                            {% elseif product.isLowStock %}
                                <span style="color: #ffd659; font-weight: bold;">{{ product.stock }} (Low Stock)</span>
                            {% else %}
                                <span style="color: #5dd879; font-weight: bold;">{{ product.stock }}</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if isOwner %}
                                <span style="display: inline-block; padding: 3px 10px; border-radius: 20px; font-size: 11px; font-weight: bold; background: rgba(40, 167, 69, 0.15); color: #5dd879; border: 1px solid rgba(40, 167, 69, 0.3);">
                                    <i class="fas fa-check"></i> You (Staff Record)
                                </span>
                            {% else %}
                                <span style="display: inline-block; padding: 3px 10px; border-radius: 20px; font-size: 11px; font-weight: 500; background: rgba(255, 255, 255, 0.05); color: #888; border: 1px solid rgba(255, 255, 255, 0.1);">
                                    <i class="fas fa-user"></i> {{ product.createdBy.name }}
                                </span>
                            {% endif %}
                        </td>
                        <td>
                            {% if isOwner %}
                                <div style="display: flex; gap: 8px;">
                                    <a href="{{ path('app_staff_product_edit', {'id': product.id}) }}" class="btn-sm-cyan" style="color: #ffd659; border-color: rgba(255, 193, 7, 0.3); background: rgba(255, 193, 7, 0.1);">
                                        <i class="fas fa-edit"></i> Edit
                                    </a>

                                    <button type="button" class="btn-sm-red" onclick="confirmStaffDelete('{{ product.id }}', '{{ product.name|e('js') }}')">
                                        <i class="fas fa-trash"></i> Delete
                                    </button>

                                    <form id="delete-form-{{ product.id }}" action="{{ path('app_staff_product_delete', {'id': product.id}) }}" method="POST" style="display: none;">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete_product_' ~ product.id) }}">
                                    </form>
                                </div>
                            {% else %}
                                <span style="color: #666; font-size: 12px; font-style: italic;">
                                    <i class="fas fa-lock" style="font-size: 11px; margin-right: 4px;"></i> Read-only
                                </span>
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" style="text-align: center; padding: 40px; color: #888;">
                            No products found matching the criteria.
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

<!-- DELETE CONFIRMATION MODAL -->
<div class="modal-overlay" id="staffDeleteModal">
    <div class="modal-box">
        <div style="font-size: 40px; color: #ff6b7b; margin-bottom: 15px;"><i class="fas fa-exclamation-triangle"></i></div>
        <h3>Confirm Product Deletion</h3>
        <p>Are you sure you want to delete <strong id="deleteProductName" style="color: #fff;"></strong>? This action cannot be undone.</p>
        <div class="modal-actions">
            <button class="modal-btn modal-btn-cancel" onclick="closeStaffDeleteModal()">Cancel</button>
            <button class="modal-btn modal-btn-danger" id="confirmDeleteSubmitBtn">Yes, Delete Product</button>
        </div>
    </div>
</div>

{% endblock %}

{% block javascripts %}
<script>
    let activeDeleteFormId = null;

    function confirmStaffDelete(productId, productName) {
        activeDeleteFormId = 'delete-form-' + productId;
        document.getElementById('deleteProductName').textContent = productName;
        document.getElementById('staffDeleteModal').style.display = 'flex';
    }

    function closeStaffDeleteModal() {
        document.getElementById('staffDeleteModal').style.display = 'none';
        activeDeleteFormId = null;
    }

    document.getElementById('confirmDeleteSubmitBtn').addEventListener('click', function() {
        if (activeDeleteFormId) {
            document.getElementById(activeDeleteFormId).submit();
        }
    });
</script>
{% endblock %}
