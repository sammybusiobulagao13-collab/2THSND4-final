{% extends 'staff/layout.html.twig' %}

{% block title %}2THSND4 - Staff Orders Fulfillment{% endblock %}

{% block page_title %}
    <h1>CUSTOMER ORDERS</h1>
    <p>View client orders, review shipping addresses, and monitor fulfillment status.</p>
{% endblock %}

{% block staff_body %}

<!-- Order Status Counters -->
<div class="staff-stat-grid" style="margin-bottom: 22px;">
    <div class="staff-stat">
        <div class="num" style="color: #fff;">{{ totalOrders }}</div>
        <div class="lbl">Total Orders</div>
    </div>
    <div class="staff-stat" style="border-top: 3px solid #ffd659;">
        <div class="num" style="color: #ffd659;">{{ processingOrders }}</div>
        <div class="lbl">Processing</div>
    </div>
    <div class="staff-stat" style="border-top: 3px solid #5bc0de;">
        <div class="num" style="color: #5bc0de;">{{ approvedOrders }}</div>
        <div class="lbl">Approved</div>
    </div>
    <div class="staff-stat" style="border-top: 3px solid #66b0ff;">
        <div class="num" style="color: #66b0ff;">{{ shippedOrders }}</div>
        <div class="lbl">Shipped</div>
    </div>
    <div class="staff-stat" style="border-top: 3px solid #5dd879;">
        <div class="num" style="color: #5dd879;">{{ deliveredOrders }}</div>
        <div class="lbl">Delivered</div>
    </div>
    <div class="staff-stat" style="border-top: 3px solid #ff6b7b;">
        <div class="num" style="color: #ff6b7b;">{{ cancelledOrders }}</div>
        <div class="lbl">Cancelled</div>
    </div>
</div>

<!-- Search & Filter Card -->
<div class="staff-card" style="margin-bottom: 25px;">
    <form method="GET" action="{{ path('app_staff_orders') }}" style="display: flex; gap: 12px; align-items: center; flex-wrap: wrap;">
        <div style="flex: 1; min-width: 250px;">
            <input type="text" name="search" value="{{ search }}" placeholder="Search by Order #, customer name, email, or phone..." style="width: 100%; padding: 11px 16px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; color: #fff; font-size: 13.5px; box-sizing: border-box;">
        </div>

        <div>
            <select name="status" style="padding: 11px 16px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; color: #fff; font-size: 13.5px; cursor: pointer;">
                <option value="all">All Statuses</option>
                <option value="Processing" {{ status == 'Processing' ? 'selected' : '' }}>Processing</option>
                <option value="Approved" {{ status == 'Approved' ? 'selected' : '' }}>Approved</option>
                <option value="Shipped" {{ status == 'Shipped' ? 'selected' : '' }}>Shipped</option>
                <option value="Delivered" {{ status == 'Delivered' ? 'selected' : '' }}>Delivered</option>
                <option value="Cancelled" {{ status == 'Cancelled' ? 'selected' : '' }}>Cancelled</option>
            </select>
        </div>

        <button type="submit" class="btn-sm-cyan" style="padding: 11px 20px; border-radius: 8px;">
            <i class="fas fa-filter"></i> Filter
        </button>

        {% if search or (status and status != 'all') %}
            <a href="{{ path('app_staff_orders') }}" class="btn-sm-red" style="padding: 11px 20px; border-radius: 8px; text-decoration: none;">
                Reset
            </a>
        {% endif %}
    </form>
</div>

<!-- Orders Table -->
<div class="staff-card">
    <div style="overflow-x: auto;">
        <table class="staff-table">
            <thead>
                <tr>
                    <th>Order #</th>
                    <th>Customer</th>
                    <th>Destination &amp; Courier</th>
                    <th>Purchased Items</th>
                    <th>Total</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                {% for order in orders %}
                    <tr>
                        <td>
                            <strong style="color: #fff; font-size: 13.5px;">#{{ order.orderNumber }}</strong>
                            <div style="font-size: 11px; color: #777; margin-top: 3px;">
                                <i class="far fa-clock"></i> {{ order.createdAt|date('M d, Y g:i A') }}
                            </div>
                        </td>
                        <td>
                            <div style="font-weight: 600; color: #fff;">{{ order.user.name }}</div>
                            <div style="font-size: 11.5px; color: #888;">{{ order.user.email }}</div>
                            <div style="font-size: 11.5px; color: #aaa; margin-top: 2px;">
                                <i class="fas fa-phone-alt" style="font-size: 9px;"></i> {{ order.phone }}
                            </div>
                        </td>
                        <td style="font-size: 12.5px;">
                            <div>{{ order.shippingAddress }}</div>
                            <div style="color: #888;">{{ order.city }}, {{ order.zipCode }}</div>
                            <div style="margin-top: 3px; color: #17a2b8; font-size: 11px; font-weight: bold;">
                                <i class="fas fa-shipping-fast"></i> {{ order.deliveryOption }} Express
                            </div>
                        </td>
                        <td>
                            <div style="font-size: 12px; color: #bbb; max-width: 260px; line-height: 1.4;">
                                {% for item in order.orderItems %}
                                    <div>&bull; <strong style="color: #fff;">{{ item.productName }}</strong> ({{ item.size }}) &times; {{ item.quantity }}</div>
                                {% endfor %}
                            </div>
                        </td>
                        <td>
                            <div style="color: #5dd879; font-weight: bold; font-size: 15px;">{{ order.formattedTotal }}</div>
                            <div style="font-size: 10px; color: #888;">{{ order.paymentMethod }}</div>
                        </td>
                        <td>
                            {% set sc = order.status|lower %}
                            <span class="sbadge sbadge-{{ sc }}">{{ order.status }}</span>

                            {% if order.status == 'Cancelled' and order.cancelReason %}
                                <div style="font-size: 10.5px; color: #888; margin-top: 4px; max-width: 170px; line-height: 1.3;">
                                    <i class="fas fa-comment-alt" style="font-size: 9px; margin-right: 2px;"></i>{{ order.cancelReason }}
                                </div>
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" style="text-align: center; padding: 45px; color: #666;">
                            <i class="fas fa-inbox" style="font-size: 32px; display: block; margin-bottom: 10px;"></i>
                            No orders matching the filter criteria.
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

{% endblock %}
