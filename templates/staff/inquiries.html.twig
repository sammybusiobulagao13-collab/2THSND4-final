{% extends 'staff/layout.html.twig' %}

{% block title %}2THSND4 - Staff Customer Inquiries{% endblock %}

{% block page_title %}
    <h1>CUSTOMER INQUIRIES &amp; SUPPORT</h1>
    <p>Review customer service inquiries, contact submissions, and client feedback.</p>
{% endblock %}

{% block staff_body %}

<!-- Inquiries Stats -->
<div class="staff-stat-grid" style="grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); margin-bottom: 24px;">
    <div class="staff-stat">
        <div class="num" style="color: #fff;">{{ totalMessages }}</div>
        <div class="lbl">Total Inquiries Received</div>
    </div>
    <div class="staff-stat" style="border-top: 3px solid #ff6b7b;">
        <div class="num" style="color: #ff6b7b;">{{ unreadCount }}</div>
        <div class="lbl">Unread Messages</div>
    </div>
    <div class="staff-stat" style="border-top: 3px solid #5dd879;">
        <div class="num" style="color: #5dd879;">{{ totalMessages - unreadCount }}</div>
        <div class="lbl">Reviewed Messages</div>
    </div>
</div>

<!-- Inquiries Table Card -->
<div class="staff-card">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; flex-wrap: wrap; gap: 10px;">
        <h3 style="font-size: 14px; text-transform: uppercase; letter-spacing: 1px; color: #fff;">
            <i class="fas fa-envelope-open-text" style="color: #17a2b8; margin-right: 8px;"></i> Client Inquiries Log
        </h3>
        <span style="font-size: 12px; color: #777;">Sorted with newest &amp; unread inquiries first</span>
    </div>

    <div style="overflow-x: auto;">
        <table class="staff-table">
            <thead>
                <tr>
                    <th>Status</th>
                    <th>Customer / Sender</th>
                    <th>Subject</th>
                    <th>Message Content</th>
                    <th>Date Received</th>
                </tr>
            </thead>
            <tbody>
                {% for message in messages %}
                    <tr>
                        <td>
                            {% if message.isUnread %}
                                <span class="sbadge sbadge-unread">
                                    <i class="fas fa-envelope"></i> Unread
                                </span>
                            {% else %}
                                <span class="sbadge sbadge-read">
                                    <i class="fas fa-check"></i> Read
                                </span>
                            {% endif %}
                        </td>
                        <td>
                            <div style="font-weight: 600; color: #fff;">{{ message.name }}</div>
                            <div style="font-size: 11.5px; color: #17a2b8; margin-top: 2px;">
                                <a href="mailto:{{ message.email }}" style="color: #17a2b8; text-decoration: none;">
                                    <i class="far fa-envelope"></i> {{ message.email }}
                                </a>
                            </div>
                        </td>
                        <td>
                            <strong style="color: #fff; font-size: 13px;">{{ message.subject }}</strong>
                        </td>
                        <td style="max-width: 380px; font-size: 13px; color: #bbb; line-height: 1.5;">
                            {{ message.message }}
                        </td>
                        <td style="color: #888; font-size: 12px; white-space: nowrap;">
                            {{ message.createdAt|date('M d, Y g:i A') }}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5" style="text-align: center; padding: 45px; color: #666;">
                            <i class="fas fa-inbox" style="font-size: 32px; display: block; margin-bottom: 10px;"></i>
                            No customer inquiries received yet.
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

{% endblock %}
