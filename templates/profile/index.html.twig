{% extends 'base.html.twig' %}

{% block title %}2THSND4 - My Account Profile{% endblock %}

{% block body %}
<section class="login-page" style="min-height: 80vh; padding: 60px 0 100px;">
    <div class="container">
        <div class="login-wrapper" style="max-width: 600px;">
            <div class="login-form-container" style="display: block;">
                <div style="text-align: center; margin-bottom: 25px;">
                    <div style="width: 70px; height: 70px; border-radius: 50%; background: #fff; color: #000; font-size: 28px; font-weight: bold; line-height: 70px; margin: 0 auto 15px;">
                        {{ user.name|slice(0, 1)|upper }}
                    </div>
                    <h2>MY ACCOUNT PROFILE</h2>
                    <div style="margin-top: 8px;">
                        {% if is_granted('ROLE_ADMIN') %}
                            <span class="role-badge role-badge-admin"><i class="fas fa-crown"></i> Administrator</span>
                        {% elseif is_granted('ROLE_STAFF') %}
                            <span class="role-badge role-badge-staff"><i class="fas fa-id-badge"></i> Staff Member</span>
                        {% else %}
                            <span class="role-badge role-badge-user"><i class="fas fa-user"></i> Customer</span>
                        {% endif %}
                    </div>
                </div>

                {{ form_start(profileForm) }}

                    <div class="form-group" style="margin-bottom: 18px;">
                        {{ form_label(profileForm.name, null, {'label_attr': {'style': 'color:#aaa; font-size:13px; display:block; margin-bottom:6px;'}}) }}
                        {{ form_widget(profileForm.name, {'attr': {'class': 'form-input', 'style': 'width:100%; padding: 13px 18px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; color: #fff;'}}) }}
                        <div style="color: #ff6b7b; font-size: 12px; margin-top: 4px;">{{ form_errors(profileForm.name) }}</div>
                    </div>

                    <div class="form-group" style="margin-bottom: 18px;">
                        {{ form_label(profileForm.username, null, {'label_attr': {'style': 'color:#aaa; font-size:13px; display:block; margin-bottom:6px;'}}) }}
                        {{ form_widget(profileForm.username, {'attr': {'class': 'form-input', 'style': 'width:100%; padding: 13px 18px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; color: #fff;'}}) }}
                        <div style="color: #ff6b7b; font-size: 12px; margin-top: 4px;">{{ form_errors(profileForm.username) }}</div>
                    </div>

                    <div class="form-group" style="margin-bottom: 25px;">
                        {{ form_label(profileForm.email, null, {'label_attr': {'style': 'color:#aaa; font-size:13px; display:block; margin-bottom:6px;'}}) }}
                        {{ form_widget(profileForm.email, {'attr': {'class': 'form-input', 'style': 'width:100%; padding: 13px 18px; background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.05); border-radius: 8px; color: #888; cursor: not-allowed;'}}) }}
                    </div>

                    <button type="submit" class="btn btn-primary" style="width: 100%; padding: 14px; border-radius: 50px; font-weight: bold; letter-spacing: 1px;">
                        UPDATE PROFILE
                    </button>

                {{ form_end(profileForm) }}

                <div style="margin-top: 30px; padding-top: 25px; border-top: 1px solid rgba(255,255,255,0.08); display: flex; justify-content: space-between; align-items: center;">
                    <span style="color: #aaa; font-size: 14px;">Need to secure your account?</span>
                    <a href="{{ path('app_change_password') }}" class="btn btn-secondary" style="border: 1px solid rgba(255,255,255,0.3); padding: 8px 18px; border-radius: 50px; color: #fff; text-decoration: none; font-size: 13px;">
                        <i class="fas fa-key"></i> Change Password
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}
