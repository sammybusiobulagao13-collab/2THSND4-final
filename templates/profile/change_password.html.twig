{% extends 'base.html.twig' %}

{% block title %}2THSND4 - Change Password{% endblock %}

{% block body %}
<section class="login-page" style="min-height: 80vh; padding: 60px 0 100px;">
    <div class="container">
        <div class="login-wrapper" style="max-width: 520px;">
            <div class="login-form-container" style="display: block;">
                <div style="text-align: center; margin-bottom: 25px;">
                    <div style="font-size: 40px; color: #ffd659; margin-bottom: 15px;"><i class="fas fa-lock"></i></div>
                    <h2>CHANGE PASSWORD</h2>
                    <p style="color: #888; font-size: 13px;">Ensure your account is protected with a strong password.</p>
                </div>

                {{ form_start(passwordForm) }}

                    <div class="form-group" style="margin-bottom: 18px;">
                        {{ form_label(passwordForm.currentPassword, null, {'label_attr': {'style': 'color:#aaa; font-size:13px; display:block; margin-bottom:6px;'}}) }}
                        {{ form_widget(passwordForm.currentPassword, {'attr': {'class': 'form-input', 'style': 'width:100%; padding: 13px 18px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; color: #fff;'}}) }}
                        <div style="color: #ff6b7b; font-size: 12px; margin-top: 4px;">{{ form_errors(passwordForm.currentPassword) }}</div>
                    </div>

                    <div class="form-group" style="margin-bottom: 18px;">
                        {{ form_label(passwordForm.newPassword.first, null, {'label_attr': {'style': 'color:#aaa; font-size:13px; display:block; margin-bottom:6px;'}}) }}
                        {{ form_widget(passwordForm.newPassword.first, {'attr': {'class': 'form-input', 'style': 'width:100%; padding: 13px 18px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; color: #fff;'}}) }}
                        <div style="color: #ff6b7b; font-size: 12px; margin-top: 4px;">{{ form_errors(passwordForm.newPassword.first) }}</div>
                    </div>

                    <div class="form-group" style="margin-bottom: 25px;">
                        {{ form_label(passwordForm.newPassword.second, null, {'label_attr': {'style': 'color:#aaa; font-size:13px; display:block; margin-bottom:6px;'}}) }}
                        {{ form_widget(passwordForm.newPassword.second, {'attr': {'class': 'form-input', 'style': 'width:100%; padding: 13px 18px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; color: #fff;'}}) }}
                        <div style="color: #ff6b7b; font-size: 12px; margin-top: 4px;">{{ form_errors(passwordForm.newPassword.second) }}</div>
                    </div>

                    <button type="submit" class="btn btn-primary" style="width: 100%; padding: 14px; border-radius: 50px; font-weight: bold; letter-spacing: 1px;">
                        SAVE NEW PASSWORD
                    </button>

                {{ form_end(passwordForm) }}

                <div style="margin-top: 25px; text-align: center;">
                    <a href="{{ path('app_profile') }}" style="color: #aaa; text-decoration: none; font-size: 13px;">
                        <i class="fas fa-arrow-left"></i> Cancel and return to profile
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}
