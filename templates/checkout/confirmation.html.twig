{% extends 'base.html.twig' %}

{% block title %}2THSND4 - Order Confirmation #{{ order.orderNumber }}{% endblock %}

{% block body %}
<section style="min-height: 80vh; padding: 60px 0 100px; background-image: url('{{ asset('images/texture.jpg') }}'); background-size: cover;">
    <div class="container" style="max-width: 800px;">
        <div style="background: rgba(10, 10, 26, 0.95); border: 1px solid rgba(255,255,255,0.1); border-radius: 16px; padding: 45px; box-shadow: 0 15px 45px rgba(0,0,0,0.8); backdrop-filter: blur(8px);">
            <div style="text-align: center; margin-bottom: 35px;">
                <div style="font-size: 55px; color: #5dd879; margin-bottom: 15px;">
                    <i class="fas fa-check-circle"></i>
                </div>
                <h1 style="font-family: var(--font-primary); color: #fff; font-size: 28px; letter-spacing: 2px; margin-bottom: 8px;">ORDER CONFIRMED</h1>
                <p style="color: #aaa; font-size: 15px;">Thank you for your order, {{ order.user.name }}!</p>
                <div style="display: inline-block; margin-top: 10px; padding: 6px 18px; border-radius: 20px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.15); color: #fff; font-size: 14px; font-weight: bold; letter-spacing: 1px;">
                    Order Number: <span style="color: #5dd879;">#{{ order.orderNumber }}</span>
                </div>
            </div>

            <!-- Order Details Grid -->
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 30px; font-size: 13px; color: #bbb;">
                <div style="background: rgba(255,255,255,0.02); padding: 18px; border-radius: 10px; border: 1px solid rgba(255,255,255,0.05);">
                    <div style="color: #fff; font-weight: bold; text-transform: uppercase; margin-bottom: 8px;"><i class="fas fa-truck"></i> Shipping Information</div>
                    <div>{{ order.shippingAddress }}</div>
                    <div>{{ order.city }}, {{ order.zipCode }}</div>
                    <div style="margin-top: 6px;">Phone: {{ order.phone }}</div>
                    <div style="margin-top: 6px;">Courier: <strong style="color: #fff;">{{ order.deliveryOption }} Express</strong></div>
                </div>

                <div style="background: rgba(255,255,255,0.02); padding: 18px; border-radius: 10px; border: 1px solid rgba(255,255,255,0.05);">
                    <div style="color: #fff; font-weight: bold; text-transform: uppercase; margin-bottom: 8px;"><i class="fas fa-info-circle"></i> Order Status</div>
                    <div>Status: <span style="color: #ffd659; font-weight: bold;">{{ order.status }}</span></div>
                    <div style="margin-top: 6px;">Payment Method: <strong>{{ order.paymentMethod }}</strong></div>
                    <div style="margin-top: 6px;">Date: {{ order.createdAt|date('F j, Y, g:i A') }}</div>
                </div>
            </div>

            <!-- Items list -->
            <h3 style="color: #fff; font-size: 16px; margin-bottom: 15px; text-transform: uppercase; letter-spacing: 1px;">Purchased Items</h3>
            <div style="border-top: 1px solid rgba(255,255,255,0.08); margin-bottom: 25px;">
                {% for item in order.orderItems %}
                    <div style="display: flex; justify-content: space-between; align-items: center; padding: 14px 0; border-bottom: 1px solid rgba(255,255,255,0.05);">
                        <div>
                            <div style="color: #fff; font-weight: 600;">{{ item.productName }}</div>
                            <div style="font-size: 12px; color: #888;">Size: {{ item.size }} &bull; Qty: {{ item.quantity }} &times; ₱{{ item.price|number_format(2) }}</div>
                        </div>
                        <div style="color: #fff; font-weight: bold;">{{ item.formattedSubtotal }}</div>
                    </div>
                {% endfor %}
            </div>

            <div style="display: flex; justify-content: space-between; align-items: center; padding: 15px 0; border-top: 2px solid rgba(255,255,255,0.15); margin-bottom: 35px;">
                <span style="font-size: 18px; color: #aaa; text-transform: uppercase;">Total Paid:</span>
                <span style="font-size: 26px; color: #5dd879; font-weight: bold;">{{ order.formattedTotal }}</span>
            </div>

            <div style="display: flex; gap: 15px; justify-content: center;">
                <a href="{{ path('app_my_orders') }}" class="btn btn-secondary" style="border: 1px solid rgba(255,255,255,0.3); border-radius: 50px; padding: 12px 28px; color: #fff; text-decoration: none;">
                    View My Orders
                </a>
                <a href="{{ path('app_shop') }}" class="btn btn-primary" style="border-radius: 50px; padding: 12px 28px; text-decoration: none;">
                    Continue Shopping
                </a>
            </div>
        </div>
    </div>
</section>
{% endblock %}
