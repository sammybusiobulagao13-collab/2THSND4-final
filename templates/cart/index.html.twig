{% extends 'base.html.twig' %}

{% block title %}2THSND4 - Shopping Cart{% endblock %}

{% block stylesheets %}
<style>
    .cart-summary-box {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 12px;
        padding: 25px 30px;
        margin-top: 30px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 20px;
    }
    .qty-control {
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .qty-input-modern {
        width: 60px;
        padding: 6px 10px;
        background: rgba(255,255,255,0.08);
        border: 1px solid rgba(255,255,255,0.2);
        border-radius: 6px;
        color: #fff;
        text-align: center;
    }
</style>
{% endblock %}

{% block body %}
<section class="cart-page">
    <div class="container">
        <div class="cart-header">
            <h1>YOUR CART</h1>
            <p>Review your streetwear selections before checkout</p>
        </div>

        {% if cart|length > 0 %}
            {% if isFreeShipping %}
                <div style="background: rgba(93, 216, 121, 0.12); border: 1px solid rgba(93, 216, 121, 0.35); border-radius: 10px; padding: 12px 20px; margin-bottom: 25px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px;">
                    <div style="color: #5dd879; font-size: 14px; font-weight: 600;">
                        <i class="fas fa-truck-fast" style="margin-right: 8px; font-size: 16px;"></i> Congratulations! Your order qualifies for <strong>FREE Shipping</strong> (₱2,000+ reached).
                    </div>
                    <span style="background: #5dd879; color: #000; font-size: 11px; font-weight: bold; padding: 3px 10px; border-radius: 20px; text-transform: uppercase; letter-spacing: 1px;">Unlocked</span>
                </div>
            {% else %}
                <div style="background: rgba(255, 214, 89, 0.1); border: 1px solid rgba(255, 214, 89, 0.3); border-radius: 10px; padding: 12px 20px; margin-bottom: 25px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px;">
                    <div style="color: #ffd659; font-size: 14px;">
                        <i class="fas fa-info-circle" style="margin-right: 8px;"></i> Add <strong style="color: #5dd879;">₱{{ remainingForFreeShipping|number_format(2) }}</strong> more to reach <strong>₱2,000</strong> and get <strong>FREE Shipping</strong>! (Standard Shipping: ₱120.00)
                    </div>
                    <a href="{{ path('app_shop') }}" style="color: #ffd659; font-size: 12px; font-weight: bold; text-decoration: underline;">Shop more items</a>
                </div>
            {% endif %}

            <div class="cart-table-wrapper">
                <table class="cart-table">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Size</th>
                            <th>Price</th>
                            <th>Quantity</th>
                            <th>Subtotal</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for item in cart %}
                            <tr>
                                <td class="cart-product">
                                    <img src="{{ asset('images/' ~ item.image) }}" alt="{{ item.name }}" style="width: 55px; height: 55px; object-fit: contain; border-radius: 8px; background: rgba(255,255,255,0.05); margin-right: 15px;">
                                    <div>
                                        <a href="{{ path('app_product_detail', {'id': item.id}) }}" style="color: #fff; text-decoration: none; font-weight: 600;">{{ item.name }}</a>
                                        <div style="font-size: 11px; color: #888; margin-top: 3px;">Stock remaining: {{ item.stock }}</div>
                                    </div>
                                </td>
                                <td>
                                    <span style="display: inline-block; padding: 4px 10px; border-radius: 6px; background: rgba(255,255,255,0.08); font-weight: bold; font-size: 12px; color: #fff;">{{ item.size }}</span>
                                </td>
                                <td class="cart-price">₱{{ item.price|number_format(2) }}</td>
                                <td class="cart-quantity">
                                    <form action="{{ path('app_cart_update') }}" method="POST" class="qty-control">
                                        <input type="hidden" name="product_id" value="{{ item.id }}">
                                        <input type="hidden" name="size" value="{{ item.size }}">
                                        <input type="number" name="quantity" value="{{ item.quantity }}" min="1" max="{{ item.stock }}" class="qty-input-modern" onchange="this.form.submit()">
                                        <button type="submit" title="Update" style="background: none; border: none; color: #aaa; cursor: pointer;"><i class="fas fa-sync-alt"></i></button>
                                    </form>
                                </td>
                                <td class="cart-total item-total" style="color: #5dd879; font-weight: bold;">₱{{ item.subtotal|number_format(2) }}</td>
                                <td class="cart-remove">
                                    <a href="{{ path('app_cart_remove', {'id': item.id, 'size': item.size}) }}" class="remove-btn" title="Remove Item" onclick="return confirm('Remove {{ item.name }} from cart?');" style="color: #ff4d5a; font-size: 18px;">
                                        <i class="fas fa-trash-alt"></i>
                                    </a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 20px; flex-wrap: wrap; gap: 15px;">
                <a href="{{ path('app_shop') }}" class="btn btn-secondary" style="border: 1px solid rgba(255,255,255,0.2); border-radius: 50px; padding: 10px 24px; color: #fff; text-decoration: none;">
                    <i class="fas fa-arrow-left"></i> Continue Shopping
                </a>

                <form action="{{ path('app_cart_clear') }}" method="POST" onsubmit="return confirm('Are you sure you want to empty your entire cart?');">
                    <input type="hidden" name="_token" value="{{ csrf_token('clear_cart') }}">
                    <button type="submit" class="btn btn-danger" style="background: transparent; border: 1px solid rgba(220, 53, 69, 0.4); color: #ff6b7b; border-radius: 50px; padding: 10px 24px; cursor: pointer;">
                        <i class="fas fa-trash"></i> Clear Cart
                    </button>
                </form>
            </div>

            <div class="cart-summary-box">
                <!-- Delivery Info / Free Shipping Indicator -->
                <div style="flex: 1; min-width: 250px;">
                    <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 6px;">
                        <i class="fas fa-truck" style="color: {{ isFreeShipping ? '#5dd879' : '#ffd659' }}; font-size: 14px;"></i>
                        <span style="color: #aaa; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 1.5px;">Delivery Status</span>
                    </div>
                    {% if isFreeShipping %}
                        <div style="color: #5dd879; font-weight: 700; font-size: 15px;">
                            <i class="fas fa-check-circle" style="margin-right: 4px;"></i> FREE Shipping Nationwide
                        </div>
                        <div style="color: #777; font-size: 12px; margin-top: 3px;">Qualified for free delivery (Orders ₱2,000+)</div>
                    {% else %}
                        <div style="color: #ffd659; font-weight: 700; font-size: 15px;">
                            Standard Shipping: ₱{{ shippingFee|number_format(2) }}
                        </div>
                        <div style="color: #888; font-size: 12px; margin-top: 3px;">
                            Free shipping on orders <strong>₱2,000+</strong>
                        </div>
                    {% endif %}
                </div>

                <!-- Price Breakdown & Checkout Action -->
                <div style="display: flex; align-items: center; gap: 25px; flex-wrap: wrap;">
                    <div style="min-width: 220px; background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.06); border-radius: 10px; padding: 12px 18px;">
                        <div style="display: flex; justify-content: space-between; align-items: center; font-size: 13px; color: #888; margin-bottom: 5px;">
                            <span>Subtotal:</span>
                            <span style="color: #fff; font-weight: 600;">₱{{ subtotal|number_format(2) }}</span>
                        </div>
                        <div style="display: flex; justify-content: space-between; align-items: center; font-size: 13px; color: #888; margin-bottom: 8px;">
                            <span>Shipping:</span>
                            <span style="{{ isFreeShipping ? 'color: #5dd879;' : 'color: #ffd659;' }} font-weight: 600;">
                                {{ isFreeShipping ? 'FREE' : '₱' ~ shippingFee|number_format(2) }}
                            </span>
                        </div>
                        <div style="display: flex; justify-content: space-between; align-items: baseline; border-top: 1px solid rgba(255,255,255,0.1); padding-top: 8px;">
                            <span style="font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; color: #aaa;">Total:</span>
                            <span style="font-size: 22px; font-weight: 800; color: #fff;">₱{{ total|number_format(2) }}</span>
                        </div>
                    </div>

                    <div>
                        {% if app.user %}
                            <a href="{{ path('app_checkout') }}" class="btn btn-primary" style="padding: 16px 36px; border-radius: 50px; text-decoration: none; font-weight: bold; letter-spacing: 1.5px; white-space: nowrap; display: inline-flex; align-items: center; gap: 10px;">
                                PROCEED TO CHECKOUT <i class="fas fa-arrow-right"></i>
                            </a>
                        {% else %}
                            <a href="{{ path('app_login') }}" class="btn btn-primary" style="padding: 16px 36px; border-radius: 50px; text-decoration: none; font-weight: bold; letter-spacing: 1.5px; white-space: nowrap; display: inline-flex; align-items: center; gap: 10px;">
                                LOG IN TO CHECKOUT <i class="fas fa-arrow-right"></i>
                            </a>
                        {% endif %}
                    </div>
                </div>
            </div>

        {% else %}
            <div style="max-width: 580px; margin: 30px auto; text-align: center; padding: 60px 30px; background: rgba(10, 10, 26, 0.7); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 16px; box-shadow: 0 15px 40px rgba(0,0,0,0.5); backdrop-filter: blur(8px);">
                <div style="font-size: 55px; color: #555; margin-bottom: 20px;">
                    <i class="fas fa-shopping-bag"></i>
                </div>
                <h3 style="color: #fff; font-size: 22px; font-weight: 700; letter-spacing: 1.5px; margin-bottom: 12px; font-family: var(--font-primary);">YOUR CART IS EMPTY</h3>
                <p style="color: #888; font-size: 14px; line-height: 1.6; max-width: 440px; margin: 0 auto 30px;">
                    Looks like you haven't added any pieces to your cart yet. Explore our latest drops and elevate your fit.
                </p>
                <div style="display: flex; justify-content: center;">
                    <a href="{{ path('app_shop') }}" class="btn btn-primary" style="display: inline-flex !important; align-items: center; justify-content: center; width: auto; min-width: 220px; padding: 14px 35px; border-radius: 50px; text-decoration: none; font-weight: bold; letter-spacing: 1.5px;">
                        EXPLORE THE SHOP
                    </a>
                </div>
            </div>
        {% endif %}
    </div>
</section>
{% endblock %}
