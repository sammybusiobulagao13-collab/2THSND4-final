{% extends 'admin/layout.html.twig' %}

{% block title %}2THSND4 - Customer Inquiries{% endblock %}

{% block admin_body %}
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px; flex-wrap: wrap; gap: 15px;">
        <div>
            <h1 style="font-family: var(--font-primary); font-size: 26px; color: #fff; letter-spacing: 1.5px;">CUSTOMER INQUIRIES</h1>
            <p style="color: #888; font-size: 14px;">Review messages and contact form submissions from website visitors.</p>
        </div>

        <div class="admin-glass-box" style="padding: 10px 20px;">
            <span style="color: #888; font-size: 12px; text-transform: uppercase;">Unread Messages:</span>
            <strong style="color: #5dd879; margin-left: 8px;">{{ unreadCount }} unread</strong>
        </div>
    </div>

    <div class="admin-table-card">
        <div style="overflow-x: auto;">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Status</th>
                        <th>Sender</th>
                        <th>Subject</th>
                        <th>Message Content</th>
                        <th>Date Received</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for message in messages %}
                        <tr>
                            <td>
                                {% if message.isUnread %}
                                    <span style="display: inline-block; padding: 3px 10px; border-radius: 20px; font-size: 11px; font-weight: bold; background: rgba(23, 162, 184, 0.2); color: #5bc0de; border: 1px solid #17a2b8;">
                                        <i class="fas fa-envelope"></i> Unread
                                    </span>
                                {% else %}
                                    <span style="display: inline-block; padding: 3px 10px; border-radius: 20px; font-size: 11px; font-weight: bold; background: rgba(255, 255, 255, 0.05); color: #888;">
                                        <i class="fas fa-check"></i> Read
                                    </span>
                                {% endif %}
                            </td>
                            <td>
                                <div style="font-weight: 600; color: #fff;">{{ message.name }}</div>
                                <div style="font-size: 12px; color: #888;">{{ message.email }}</div>
                            </td>
                            <td><strong style="color: #fff;">{{ message.subject }}</strong></td>
                            <td style="max-width: 320px; font-size: 13px; color: #bbb; line-height: 1.5;">
                                {{ message.message }}
                            </td>
                            <td style="color: #888; font-size: 13px;">{{ message.createdAt|date('M d, Y g:i A') }}</td>
                            <td>
                                <div style="display: flex; gap: 8px;">
                                    {% if message.isUnread %}
                                        <form action="{{ path('app_admin_message_read', {'id': message.id}) }}" method="POST" style="display: inline;">
                                            <input type="hidden" name="_token" value="{{ csrf_token('read_msg_' ~ message.id) }}">
                                            <button type="submit" class="btn-sm-action btn-sm-toggle" title="Mark as read">
                                                <i class="fas fa-envelope-open"></i> Read
                                            </button>
                                        </form>
                                    {% endif %}

                                    <button type="button" class="btn-sm-action btn-sm-delete" onclick="openAdminConfirm('delete-msg-form-{{ message.id }}', 'Delete Message', 'Are you sure you want to delete this inquiry from {{ message.name|e('js') }}?');">
                                        <i class="fas fa-trash"></i> Delete
                                    </button>
                                    <form id="delete-msg-form-{{ message.id }}" action="{{ path('app_admin_message_delete', {'id': message.id}) }}" method="POST" style="display: none;">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete_msg_' ~ message.id) }}">
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" style="text-align: center; padding: 40px; color: #888;">No inquiries received yet.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
