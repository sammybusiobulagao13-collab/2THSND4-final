<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}2THSND4 - Admin Portal{% endblock %}</title>
    <link rel="icon" type="image/png" href="{{ asset('images/forwbe.png') }}">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="stylesheet" href="{{ asset('style.css') }}">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: Arial, sans-serif; background: #0a0a1a; color: #fff; }
        .admin-container { display: flex; min-height: 100vh; }

        /* Sidebar */
        .admin-sidebar {
            width: 260px;
            background: #000;
            padding: 20px;
            border-right: 1px solid rgba(255,255,255,0.05);
            min-height: 100vh;
            position: fixed;
            height: 100%;
            overflow-y: auto;
            z-index: 99;
        }
        .admin-sidebar .logo {
            font-size: 22px;
            font-weight: 700;
            color: #fff;
            padding: 15px 0;
            border-bottom: 1px solid rgba(255,255,255,0.05);
            margin-bottom: 20px;
            text-align: center;
            letter-spacing: 2px;
        }
        .admin-sidebar ul { list-style: none; padding: 0; }
        .admin-sidebar ul li { margin-bottom: 3px; }
        .admin-sidebar ul li a {
            display: flex;
            align-items: center;
            padding: 12px 18px;
            color: #888;
            text-decoration: none;
            border-radius: 10px;
            transition: all 0.3s;
            font-size: 14px;
        }
        .admin-sidebar ul li a:hover,
        .admin-sidebar ul li a.active {
            background: rgba(255,255,255,0.06);
            color: #fff;
        }
        .admin-sidebar ul li a i {
            width: 24px;
            margin-right: 12px;
            text-align: center;
        }
        .admin-sidebar .sidebar-badge {
            margin-left: auto;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 20px;
            height: 20px;
            padding: 0 6px;
            border-radius: 10px;
            font-size: 11px;
            font-weight: 800;
            line-height: 1;
        }
        .sidebar-badge-orders {
            background: rgba(255, 193, 7, 0.25);
            color: #ffd659;
            border: 1px solid rgba(255, 193, 7, 0.5);
            box-shadow: 0 0 10px rgba(255, 193, 7, 0.3);
        }
        .sidebar-badge-messages {
            background: rgba(220, 53, 69, 0.25);
            color: #ff6b7b;
            border: 1px solid rgba(220, 53, 69, 0.5);
            box-shadow: 0 0 10px rgba(220, 53, 69, 0.3);
        }

        /* Modal Confirmation */
        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.85);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 999999;
            backdrop-filter: blur(6px);
        }
        .modal-box {
            background: #111122;
            border: 1px solid rgba(255, 255, 255, 0.15);
            border-radius: 14px;
            padding: 30px;
            width: 90%;
            max-width: 440px;
            text-align: center;
            box-shadow: 0 15px 50px rgba(0,0,0,0.85);
            animation: modalFadeIn 0.25s ease;
        }
        @keyframes modalFadeIn {
            from { opacity: 0; transform: scale(0.95) translateY(-10px); }
            to { opacity: 1; transform: scale(1) translateY(0); }
        }
        .modal-box h3 { color: #fff; margin-bottom: 12px; font-family: var(--font-primary); font-size: 20px; }
        .modal-box p { color: #aaa; font-size: 14px; margin-bottom: 25px; line-height: 1.5; }
        .modal-actions { display: flex; gap: 12px; justify-content: center; }
        .modal-btn {
            padding: 10px 24px;
            border-radius: 50px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
            text-decoration: none;
            border: none;
        }
        .modal-btn-cancel { background: transparent; border: 1px solid rgba(255,255,255,0.3); color: #fff; }
        .modal-btn-cancel:hover { background: rgba(255,255,255,0.1); }
        .modal-btn-danger { background: #dc3545; color: #fff; }
        .modal-btn-danger:hover { background: #bd2130; }
        .admin-sidebar .logout-link {
            margin-top: 30px;
            border-top: 1px solid rgba(255,255,255,0.05);
            padding-top: 15px;
        }
        .admin-sidebar .logout-link a { color: #ff4d5a !important; }
        .admin-sidebar .logout-link a:hover { background: rgba(220,53,69,0.1) !important; }

        /* Main Content */
        .admin-content {
            margin-left: 260px;
            flex: 1;
            padding: 35px;
            min-height: 100vh;
            width: calc(100% - 260px);
            background-image: url('{{ asset('images/texture.jpg') }}');
            background-size: cover;
            background-attachment: fixed;
            position: relative;
        }
        .admin-content::before {
            content: '';
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(10, 10, 26, 0.88);
            z-index: 0;
        }
        .admin-inner {
            position: relative;
            z-index: 1;
        }

        /* Stats & Grids */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }
        .stat-card {
            background: rgba(255,255,255,0.03);
            padding: 22px 25px;
            border-radius: 12px;
            border: 1px solid rgba(255,255,255,0.06);
            transition: all 0.3s;
            backdrop-filter: blur(5px);
        }
        .stat-card:hover {
            border-color: rgba(255,255,255,0.18);
            transform: translateY(-3px);
        }
        .stat-card .stat-icon { font-size: 26px; margin-bottom: 10px; }
        .stat-card .stat-number { font-size: 30px; font-weight: 700; color: #fff; }
        .stat-card .stat-label { color: #888; font-size: 13px; margin-top: 5px; text-transform: uppercase; letter-spacing: 0.5px; }

        /* Tables & Forms */
        .admin-table-card {
            background: rgba(255,255,255,0.03);
            border-radius: 12px;
            padding: 25px;
            border: 1px solid rgba(255,255,255,0.06);
            backdrop-filter: blur(5px);
            margin-bottom: 30px;
        }
        .admin-table {
            width: 100%;
            border-collapse: collapse;
        }
        .admin-table th, .admin-table td {
            padding: 14px 16px;
            text-align: left;
            border-bottom: 1px solid rgba(255,255,255,0.06);
            color: #ddd;
            font-size: 14px;
        }
        .admin-table th {
            color: #888;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-weight: 600;
        }
        .admin-table tr:hover td {
            background: rgba(255,255,255,0.02);
        }

        /* Action Buttons */
        .btn-sm-action {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 12px;
            border-radius: 6px;
            font-size: 12px;
            font-weight: bold;
            text-decoration: none;
            border: none;
            cursor: pointer;
            transition: all 0.2s;
        }
        .btn-sm-edit { background: rgba(255, 193, 7, 0.1); color: #ffd659; border: 1px solid rgba(255, 193, 7, 0.3); }
        .btn-sm-edit:hover { background: #ffd659; color: #000; }
        .btn-sm-delete { background: rgba(220, 53, 69, 0.1); color: #ff6b7b; border: 1px solid rgba(220, 53, 69, 0.3); }
        .btn-sm-delete:hover { background: #dc3545; color: #fff; }
        .btn-sm-toggle { background: rgba(23, 162, 184, 0.1); color: #17a2b8; border: 1px solid rgba(23, 162, 184, 0.3); }
        .btn-sm-toggle:hover { background: #17a2b8; color: #fff; }

        @media (max-width: 900px) {
            .admin-sidebar { width: 70px; padding: 15px 10px; }
            .admin-sidebar .logo { font-size: 14px; letter-spacing: 0; }
            .admin-sidebar ul li a span { display: none; }
            .admin-sidebar ul li a i { margin-right: 0; }
            .admin-content { margin-left: 70px; width: calc(100% - 70px); padding: 20px; }
        }
    </style>
    {% block stylesheets %}{% endblock %}
</head>
<body>
    <div class="admin-container">
        <!-- SIDEBAR -->
        <aside class="admin-sidebar">
            <div class="logo">
                <i class="fas fa-crown" style="color: #ff4d5a; font-size: 18px; margin-right: 6px;"></i> 2THSND4
            </div>
            <ul>
                <li>
                    <a href="{{ path('app_admin_dashboard') }}" class="{{ app.current_route == 'app_admin_dashboard' ? 'active' : '' }}">
                        <i class="fas fa-chart-line"></i> <span>Dashboard</span>
                    </a>
                </li>
                <li>
                    <a href="{{ path('app_admin_users') }}" class="{{ app.current_route starts with 'app_admin_user' ? 'active' : '' }}">
                        <i class="fas fa-users-cog"></i> <span>Staff & Users</span>
                    </a>
                </li>
                <li>
                    <a href="{{ path('app_admin_products') }}" class="{{ app.current_route starts with 'app_admin_product' ? 'active' : '' }}">
                        <i class="fas fa-boxes"></i> <span>Products</span>
                    </a>
                </li>
                <li>
                    <a href="{{ path('app_admin_orders') }}" class="{{ app.current_route starts with 'app_admin_order' ? 'active' : '' }}" style="justify-content: space-between;">
                        <span><i class="fas fa-shipping-fast"></i> Orders</span>
                        {% if adminNotifications.pendingOrders > 0 %}
                            <span class="sidebar-badge sidebar-badge-orders">{{ adminNotifications.pendingOrders }}</span>
                        {% endif %}
                    </a>
                </li>
                <li>
                    <a href="{{ path('app_admin_messages') }}" class="{{ app.current_route starts with 'app_admin_message' ? 'active' : '' }}" style="justify-content: space-between;">
                        <span><i class="fas fa-envelope"></i> Inquiries</span>
                        {% if adminNotifications.unreadMessages > 0 %}
                            <span class="sidebar-badge sidebar-badge-messages">{{ adminNotifications.unreadMessages }}</span>
                        {% endif %}
                    </a>
                </li>
                <div style="border-top: 1px solid rgba(255,255,255,0.06); margin: 15px 0;"></div>
                <li>
                    <a href="{{ path('app_shop') }}">
                        <i class="fas fa-store"></i> <span>View Storefront</span>
                    </a>
                </li>
                <li>
                    <a href="{{ path('app_profile') }}">
                        <i class="fas fa-user-shield"></i> <span>My Admin Profile</span>
                    </a>
                </li>
                <li class="logout-link">
                    <a href="{{ path('app_logout') }}">
                        <i class="fas fa-sign-out-alt"></i> <span>Log Out</span>
                    </a>
                </li>
            </ul>
        </aside>

        <!-- MAIN ADMIN CONTENT -->
        <main class="admin-content">
            <div class="admin-inner">
                <!-- Top admin bar -->
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px; border-bottom: 1px solid rgba(255,255,255,0.06); padding-bottom: 15px;">
                    <div>
                        <span style="font-size: 13px; color: #888; text-transform: uppercase; letter-spacing: 1px;">Admin Console &bull; Security Level: Maximum</span>
                    </div>
                    <div style="display: flex; align-items: center; gap: 15px;">
                        <span style="font-size: 14px; color: #fff;">
                            <i class="fas fa-user-circle" style="color: #ff4d5a; margin-right: 6px;"></i>
                            {{ app.user.name }}
                        </span>
                        <a href="{{ path('app_shop') }}" class="btn-sm-action btn-sm-toggle" style="border-radius: 20px; padding: 6px 16px;">
                            <i class="fas fa-external-link-alt"></i> Store
                        </a>
                    </div>
                </div>

                <!-- Flash Messages -->
                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="flash-alert flash-{{ label == 'error' ? 'danger' : label }}" style="margin-bottom: 20px;">
                            <div>
                                {% if label in ['danger', 'error'] %}
                                    <i class="fas fa-exclamation-circle" style="margin-right: 8px;"></i>
                                {% elseif label == 'success' %}
                                    <i class="fas fa-check-circle" style="margin-right: 8px;"></i>
                                {% else %}
                                    <i class="fas fa-info-circle" style="margin-right: 8px;"></i>
                                {% endif %}
                                {{ message }}
                            </div>
                            <button class="flash-close" onclick="this.parentElement.remove();">&times;</button>
                        </div>
                    {% endfor %}
                {% endfor %}

                {% block admin_body %}{% endblock %}
            </div>
        </main>
    </div>

    <!-- Generic Confirmation Modal for Deletion -->
    <div class="modal-overlay" id="adminConfirmModal">
        <div class="modal-box">
            <div style="font-size: 40px; color: #ff6b7b; margin-bottom: 15px;"><i class="fas fa-exclamation-triangle"></i></div>
            <h3 id="adminModalTitle">Confirm Action</h3>
            <p id="adminModalMessage">Are you sure you want to proceed?</p>
            <div class="modal-actions">
                <button class="modal-btn modal-btn-cancel" onclick="closeAdminModal()">Cancel</button>
                <button class="modal-btn modal-btn-danger" id="adminModalConfirmBtn">Yes, Confirm</button>
            </div>
        </div>
    </div>

    <script>
        let pendingFormId = null;
        function openAdminConfirm(formId, title, message) {
            pendingFormId = formId;
            document.getElementById('adminModalTitle').textContent = title || 'Confirm Deletion';
            document.getElementById('adminModalMessage').textContent = message || 'Are you sure you want to delete this record? This action cannot be reversed.';
            document.getElementById('adminConfirmModal').style.display = 'flex';
        }
        function closeAdminModal() {
            document.getElementById('adminConfirmModal').style.display = 'none';
            pendingFormId = null;
        }
        document.getElementById('adminModalConfirmBtn').addEventListener('click', function() {
            if (pendingFormId) {
                document.getElementById(pendingFormId).submit();
            }
        });
    </script>
    {% block javascripts %}{% endblock %}
</body>
</html>
