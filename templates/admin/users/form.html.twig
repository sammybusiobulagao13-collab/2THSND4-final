{% extends 'admin/layout.html.twig' %}

{% block title %}2THSND4 - {{ isEdit ? 'Edit User / Staff' : 'Create User / Staff' }}{% endblock %}

{% block admin_body %}
    <div style="margin-bottom: 25px;">
        <a href="{{ path('app_admin_users') }}" style="color: #888; font-size: 13px; text-decoration: none;">
            <i class="fas fa-arrow-left"></i> Back to User Management
        </a>
        <h1 style="font-family: var(--font-primary); font-size: 24px; color: #fff; margin-top: 10px; letter-spacing: 1.5px;">
            {{ isEdit ? 'EDIT USER ACCOUNT' : 'CREATE NEW USER / STAFF ACCOUNT' }}
        </h1>
        <p style="color: #888; font-size: 14px;">
            {{ isEdit ? 'Update name, email, credentials, assigned system role, and active status.' : 'Register a new administrator, staff member, or customer directly.' }}
        </p>
    </div>

    <div class="admin-table-card" style="max-width: 650px;">
        {{ form_start(userForm) }}

            <div class="form-group" style="margin-bottom: 18px;">
                {{ form_label(userForm.name, null, {'label_attr': {'style': 'color:#aaa; font-size:13px; display:block; margin-bottom:6px;'}}) }}
                {{ form_widget(userForm.name, {'attr': {'class': 'form-input', 'style': 'width:100%; padding: 13px 18px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; color: #fff;'}}) }}
                <div style="color: #ff6b7b; font-size: 12px; margin-top: 4px;">{{ form_errors(userForm.name) }}</div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-bottom: 18px;">
                <div>
                    {{ form_label(userForm.email, null, {'label_attr': {'style': 'color:#aaa; font-size:13px; display:block; margin-bottom:6px;'}}) }}
                    {{ form_widget(userForm.email, {'attr': {'class': 'form-input', 'style': 'width:100%; padding: 13px 18px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; color: #fff;'}}) }}
                    <div style="color: #ff6b7b; font-size: 12px; margin-top: 4px;">{{ form_errors(userForm.email) }}</div>
                </div>
                <div>
                    {{ form_label(userForm.username, null, {'label_attr': {'style': 'color:#aaa; font-size:13px; display:block; margin-bottom:6px;'}}) }}
                    {{ form_widget(userForm.username, {'attr': {'class': 'form-input', 'style': 'width:100%; padding: 13px 18px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; color: #fff;'}}) }}
                    <div style="color: #ff6b7b; font-size: 12px; margin-top: 4px;">{{ form_errors(userForm.username) }}</div>
                </div>
            </div>

            <div class="form-group" style="margin-bottom: 18px;">
                {{ form_label(userForm.role, null, {'label_attr': {'style': 'color:#aaa; font-size:13px; display:block; margin-bottom:6px;'}}) }}
                {{ form_widget(userForm.role, {'attr': {'class': 'form-input', 'style': 'width:100%; padding: 13px 18px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; color: #fff; cursor: pointer;'}}) }}
                <div style="font-size: 11px; color: #888; margin-top: 5px;">
                    <i class="fas fa-info-circle"></i> Admin has system-wide full control; Staff can manage own product records only; Customer can shop and place orders.
                </div>
            </div>

            <div class="form-group" style="margin-bottom: 20px;">
                {{ form_label(userForm.plainPassword, null, {'label_attr': {'style': 'color:#aaa; font-size:13px; display:block; margin-bottom:6px;'}}) }}
                {{ form_widget(userForm.plainPassword, {'attr': {'class': 'form-input', 'style': 'width:100%; padding: 13px 18px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; color: #fff;'}}) }}
                <div style="color: #ff6b7b; font-size: 12px; margin-top: 4px;">{{ form_errors(userForm.plainPassword) }}</div>
            </div>

            <div class="form-group" style="margin-bottom: 25px; background: rgba(255,255,255,0.02); padding: 15px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.05);">
                <div style="display: flex; align-items: center; gap: 10px;">
                    {{ form_widget(userForm.isActive, {'attr': {'style': 'width: 20px; height: 20px; cursor: pointer;'}}) }}
                    {{ form_label(userForm.isActive, null, {'label_attr': {'style': 'color:#fff; font-size:14px; font-weight: 500; cursor: pointer;'}}) }}
                </div>
                <div style="color: #888; font-size: 12px; margin-top: 5px; margin-left: 30px;">
                    Unchecking this disables or archives the user. Disabled users cannot authenticate.
                </div>
            </div>

            <button type="submit" class="btn btn-primary" style="width: 100%; padding: 14px; border-radius: 50px; font-weight: bold; letter-spacing: 1.5px;">
                {{ isEdit ? 'SAVE USER MODIFICATIONS' : 'CREATE USER ACCOUNT' }}
            </button>

        {{ form_end(userForm) }}
    </div>
{% endblock %}
