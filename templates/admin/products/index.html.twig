{% extends 'admin/layout.html.twig' %}

{% block title %}2THSND4 - Product Inventory Management{% endblock %}

{% block admin_body %}
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px; flex-wrap: wrap; gap: 15px;">
        <div>
            <h1 style="font-family: var(--font-primary); font-size: 26px; color: #fff; letter-spacing: 1.5px;">INVENTORY &amp; PRODUCTS</h1>
            <p style="color: #888; font-size: 14px;">Full data access: View, create, edit, or delete any product record created by Admin or Staff.</p>
        </div>

        <div>
            <a href="{{ path('app_admin_product_new') }}" class="btn-sm-action btn-sm-toggle" style="padding: 10px 20px; font-size: 13px; border-radius: 50px;">
                <i class="fas fa-plus-circle"></i> ADD NEW PRODUCT
            </a>
        </div>
    </div>

    <!-- Inventory overview chips -->
    <div style="display: flex; gap: 15px; margin-bottom: 25px; flex-wrap: wrap;">
        <div style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.06); border-radius: 8px; padding: 10px 20px;">
            <span style="color: #888; font-size: 12px; text-transform: uppercase;">Total Catalog:</span>
            <strong style="color: #fff; margin-left: 8px;">{{ totalProducts }} items</strong>
        </div>
        <div style="background: rgba(255, 193, 7, 0.08); border: 1px solid rgba(255, 193, 7, 0.2); border-radius: 8px; padding: 10px 20px;">
            <span style="color: #ffd659; font-size: 12px; text-transform: uppercase;">Low Stock Warning:</span>
            <strong style="color: #ffd659; margin-left: 8px;">{{ lowStock }} items</strong>
        </div>
        <div style="background: rgba(220, 53, 69, 0.08); border: 1px solid rgba(220, 53, 69, 0.2); border-radius: 8px; padding: 10px 20px;">
            <span style="color: #ff6b7b; font-size: 12px; text-transform: uppercase;">Out of Stock:</span>
            <strong style="color: #ff6b7b; margin-left: 8px;">{{ outOfStock }} items</strong>
        </div>
    </div>

    <!-- Search & Filters -->
    <div class="admin-table-card">
        <form method="GET" action="{{ path('app_admin_products') }}" style="display: flex; gap: 15px; align-items: center; margin-bottom: 20px; flex-wrap: wrap;">
            <div style="flex: 1; min-width: 250px;">
                <input type="text" name="search" value="{{ search }}" placeholder="Search products by title, category, description..." style="width: 100%; padding: 10px 16px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; color: #fff;">
            </div>

            <div>
                <select name="category" style="padding: 10px 16px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; color: #fff;">
                    <option value="">All Categories</option>
                    <option value="Streetwear" {{ category == 'Streetwear' ? 'selected' : '' }}>Streetwear</option>
                    <option value="T-Shirts" {{ category == 'T-Shirts' ? 'selected' : '' }}>T-Shirts</option>
                    <option value="Hoodies" {{ category == 'Hoodies' ? 'selected' : '' }}>Hoodies</option>
                    <option value="Jeans & Jorts" {{ category == 'Jeans & Jorts' ? 'selected' : '' }}>Jeans & Jorts</option>
                    <option value="Headwear" {{ category == 'Headwear' ? 'selected' : '' }}>Headwear</option>
                </select>
            </div>

            <div>
                <select name="stock" style="padding: 10px 16px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; color: #fff;">
                    <option value="">All Inventory Status</option>
                    <option value="low" {{ stockStatus == 'low' ? 'selected' : '' }}>Low Stock (1-3)</option>
                    <option value="out" {{ stockStatus == 'out' ? 'selected' : '' }}>Out of Stock (0)</option>
                    <option value="in" {{ stockStatus == 'in' ? 'selected' : '' }}>In Stock (>3)</option>
                </select>
            </div>

            <button type="submit" class="btn-sm-action btn-sm-toggle" style="padding: 10px 18px; border-radius: 8px;">
                <i class="fas fa-filter"></i> Search &amp; Filter
            </button>
            {% if search or category or stockStatus %}
                <a href="{{ path('app_admin_products') }}" class="btn-sm-action btn-sm-delete" style="padding: 10px 18px; border-radius: 8px;">
                    Reset
                </a>
            {% endif %}
        </form>

        <div style="overflow-x: auto;">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>Category</th>
                        <th>Price</th>
                        <th>Stock Level</th>
                        <th>Record Creator</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for product in products %}
                        <tr>
                            <td style="display: flex; align-items: center; gap: 12px;">
                                <img src="{{ asset('images/' ~ product.image) }}" alt="{{ product.name }}" style="width: 48px; height: 48px; object-fit: contain; border-radius: 8px; background: rgba(255,255,255,0.05);">
                                <div>
                                    <strong style="color: #fff;">{{ product.name }}</strong>
                                    <div style="font-size: 11px; color: #888;">Sizes: {{ product.sizes }}</div>
                                </div>
                            </td>
                            <td>{{ product.category }}</td>
                            <td style="color: #fff; font-weight: 600;">{{ product.formattedPrice }}</td>
                            <td>
                                <div style="display: flex; align-items: center; gap: 10px;">
                                    {% if product.isOutOfStock %}
                                        <span style="color: #ff6b7b; font-weight: bold;">0 (Sold Out)</span>
                                    {% elseif product.isLowStock %}
                                        <span style="color: #ffd659; font-weight: bold;">{{ product.stock }} (Low Stock)</span>
                                    {% else %}
                                        <span style="color: #5dd879; font-weight: bold;">{{ product.stock }}</span>
                                    {% endif %}

                                    <!-- Quick +1 Stock Button -->
                                    <form action="{{ path('app_admin_product_quick_stock', {'id': product.id}) }}" method="POST" style="display: inline;">
                                        <input type="hidden" name="_token" value="{{ csrf_token('quick_stock_' ~ product.id) }}">
                                        <input type="hidden" name="add_stock" value="1">
                                        <button type="submit" class="btn-sm-action" style="padding: 2px 8px; font-size: 11px; background: rgba(255,255,255,0.08); color: #fff; border: 1px solid rgba(255,255,255,0.2);" title="Add 1 to stock">
                                            +1 Stock
                                        </button>
                                    </form>
                                </div>
                            </td>
                            <td>
                                {% if product.createdBy.isAdmin %}
                                    <span style="display: inline-block; padding: 3px 10px; border-radius: 20px; font-size: 11px; font-weight: bold; background: rgba(220, 53, 69, 0.15); color: #ff6b7b; border: 1px solid rgba(220, 53, 69, 0.3);">
                                        <i class="fas fa-crown"></i> Admin ({{ product.createdBy.name }})
                                    </span>
                                {% else %}
                                    <span style="display: inline-block; padding: 3px 10px; border-radius: 20px; font-size: 11px; font-weight: bold; background: rgba(23, 162, 184, 0.15); color: #17a2b8; border: 1px solid rgba(23, 162, 184, 0.3);">
                                        <i class="fas fa-id-badge"></i> Staff: {{ product.createdBy.name }}
                                    </span>
                                {% endif %}
                            </td>
                            <td>
                                <div style="display: flex; gap: 8px;">
                                    <a href="{{ path('app_admin_product_edit', {'id': product.id}) }}" class="btn-sm-action btn-sm-edit">
                                        <i class="fas fa-edit"></i> Edit
                                    </a>

                                    <button type="button" class="btn-sm-action btn-sm-delete" onclick="openAdminConfirm('delete-product-form-{{ product.id }}', 'Delete Product', 'Are you sure you want to delete {{ product.name|e('js') }} from the inventory?');">
                                        <i class="fas fa-trash"></i> Delete
                                    </button>
                                    <form id="delete-product-form-{{ product.id }}" action="{{ path('app_admin_product_delete', {'id': product.id}) }}" method="POST" style="display: none;">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete_product_' ~ product.id) }}">
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" style="text-align: center; padding: 40px; color: #888;">No products found matching criteria.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
