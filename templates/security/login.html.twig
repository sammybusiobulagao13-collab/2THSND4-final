{% extends 'base.html.twig' %}

{% block title %}2THSND4 - Login{% endblock %}

{% block body %}
<section class="login-page">
    <div class="container">
        <div class="login-wrapper">

            <div class="login-form-container">
                <h2>LOGIN</h2>

                {% if error %}
                    <div class="flash-alert flash-danger" style="margin-bottom: 20px;">
                        <i class="fas fa-exclamation-circle"></i> {{ error.messageKey|trans(error.messageData, 'security') }}
                    </div>
                {% endif %}

                <form method="POST" action="{{ path('app_login') }}">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                    <div class="form-group" style="margin-bottom: 20px;">
                        <label style="display:block; color: #888; font-size: 13px; margin-bottom: 8px;">EMAIL ADDRESS</label>
                        <input type="email" name="email" value="{{ last_username }}" placeholder="e.g. admin@2thsnd4.com" required autofocus class="form-input" style="width:100%; padding: 14px 18px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; color: #fff;">
                    </div>

                    <div class="form-group" style="margin-bottom: 25px;">
                        <label style="display:block; color: #888; font-size: 13px; margin-bottom: 8px;">PASSWORD</label>
                        <input type="password" name="password" placeholder="Enter your password" required class="form-input" style="width:100%; padding: 14px 18px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; color: #fff;">
                    </div>

                    <button type="submit" class="btn btn-primary" style="width: 100%; padding: 14px; font-weight: bold; letter-spacing: 2px;">LOGIN</button>
                </form>

                <p class="form-switch" style="margin-top: 25px; text-align: center; color: #888;">
                    Don't have an account? <a href="{{ path('app_register') }}" style="color: #fff; text-decoration: underline;">Sign Up</a>
                </p>

            </div>

        </div>
    </div>
</section>
{% endblock %}
