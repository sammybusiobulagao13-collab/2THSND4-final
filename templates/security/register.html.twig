{% extends 'base.html.twig' %}

{% block title %}2THSND4 - Sign Up{% endblock %}

{% block body %}
<section class="login-page">
    <div class="container">
        <div class="login-wrapper">

            <div class="register-form-container" style="display: block;">
                <h2>SIGN UP</h2>

                {{ form_start(registrationForm) }}

                    <div class="form-group" style="margin-bottom: 18px;">
                        {{ form_label(registrationForm.name, null, {'label_attr': {'style': 'display:block; color: #888; font-size: 13px; margin-bottom: 6px;'}}) }}
                        {{ form_widget(registrationForm.name, {'attr': {'class': 'form-input', 'style': 'width:100%; padding: 13px 18px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; color: #fff;'}}) }}
                        <div style="color: #ff6b7b; font-size: 12px; margin-top: 4px;">{{ form_errors(registrationForm.name) }}</div>
                    </div>

                    <div class="form-group" style="margin-bottom: 18px;">
                        {{ form_label(registrationForm.email, null, {'label_attr': {'style': 'display:block; color: #888; font-size: 13px; margin-bottom: 6px;'}}) }}
                        {{ form_widget(registrationForm.email, {'attr': {'class': 'form-input', 'style': 'width:100%; padding: 13px 18px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; color: #fff;'}}) }}
                        <div style="color: #ff6b7b; font-size: 12px; margin-top: 4px;">{{ form_errors(registrationForm.email) }}</div>
                    </div>

                    <div class="form-group" style="margin-bottom: 18px;">
                        {{ form_label(registrationForm.username, null, {'label_attr': {'style': 'display:block; color: #888; font-size: 13px; margin-bottom: 6px;'}}) }}
                        {{ form_widget(registrationForm.username, {'attr': {'class': 'form-input', 'style': 'width:100%; padding: 13px 18px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; color: #fff;'}}) }}
                        <div style="color: #ff6b7b; font-size: 12px; margin-top: 4px;">{{ form_errors(registrationForm.username) }}</div>
                    </div>

                    <div class="form-group" style="margin-bottom: 18px;">
                        {{ form_label(registrationForm.plainPassword.first, null, {'label_attr': {'style': 'display:block; color: #888; font-size: 13px; margin-bottom: 6px;'}}) }}
                        {{ form_widget(registrationForm.plainPassword.first, {'attr': {'class': 'form-input', 'style': 'width:100%; padding: 13px 18px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; color: #fff;'}}) }}
                        <div style="color: #ff6b7b; font-size: 12px; margin-top: 4px;">{{ form_errors(registrationForm.plainPassword.first) }}</div>
                    </div>

                    <div class="form-group" style="margin-bottom: 25px;">
                        {{ form_label(registrationForm.plainPassword.second, null, {'label_attr': {'style': 'display:block; color: #888; font-size: 13px; margin-bottom: 6px;'}}) }}
                        {{ form_widget(registrationForm.plainPassword.second, {'attr': {'class': 'form-input', 'style': 'width:100%; padding: 13px 18px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; color: #fff;'}}) }}
                        <div style="color: #ff6b7b; font-size: 12px; margin-top: 4px;">{{ form_errors(registrationForm.plainPassword.second) }}</div>
                    </div>

                    <button type="submit" class="btn btn-primary" style="width: 100%; padding: 14px; font-weight: bold; letter-spacing: 2px;">CREATE ACCOUNT</button>

                {{ form_end(registrationForm) }}

                <p class="form-switch" style="margin-top: 25px; text-align: center; color: #888;">
                    Already have an account? <a href="{{ path('app_login') }}" style="color: #fff; text-decoration: underline;">Login</a>
                </p>

            </div>

        </div>
    </div>
</section>
{% endblock %}
